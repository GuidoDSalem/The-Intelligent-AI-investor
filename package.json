{
  "name": "the-intelligent-ai-investor",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de análisis de acciones al estilo de Benjamin Graham, con datos de SEC EDGAR.",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/construir.ts",
    "start": "npm run build && tsx src/server/servidor.ts",
